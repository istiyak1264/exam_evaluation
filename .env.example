# Copy to .env and adjust.

APP_ENV=development
WEB_PORT=8090
DB_PORT=53306

# use openssl to generate a random mysql password: openssl rand -base64 12
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword

# use openssl to generate 48 random bytes: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
ALLOWED_ORIGINS=http://localhost:8090

# The single administrator is defined only here (or in your real .env);
# no email, password or name is compiled into the application.
# Every other account is created by this administrator in the People screen.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please
BOOTSTRAP_ADMIN_NAME=Administrator

# Storage driver to use for file uploads. Options: local, s3, gcs, azure
STORAGE_DRIVER=local
