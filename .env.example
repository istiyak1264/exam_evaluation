# Copy to .env and adjust.

APP_ENV=development
WEB_PORT=8090
DB_PORT=53306

# use openssl to generate a random mysql password: openssl rand -base64 12
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword

# use openssl to generate 48 random bytes: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
ALLOWED_ORIGINS=http://localhost:8090

# The one account seeded on first boot; change both before real use.
BOOTSTRAP_ADMIN_EMAIL=admin@uni.test
BOOTSTRAP_ADMIN_PASSWORD=password

# Password for the demo cohort created by the `seed` profile.
SEED_PASSWORD=Password123

# Storage driver to use for file uploads. Options: local, s3, gcs, azure
STORAGE_DRIVER=local
