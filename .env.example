# Copy to .env and adjust. Never commit real secrets.

APP_ENV=development
WEB_PORT=8090
DB_PORT=53306

# Database credentials — invent your own.
MYSQL_PASSWORD=exam_local_pw
MYSQL_ROOT_PASSWORD=root_local_pw

# 32+ random bytes; the server refuses to boot in production with a short one.
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef
ALLOWED_ORIGINS=http://localhost:8090

# The one account seeded on first boot; change both before real use.
BOOTSTRAP_ADMIN_EMAIL=admin@uni.test
BOOTSTRAP_ADMIN_PASSWORD=ExamOffice#2026

# Password for the demo cohort created by the `seed` profile.
SEED_PASSWORD=ExamOffice#2026

# Storage: local disk is fine for a single host; s3 for ECS.
STORAGE_DRIVER=local
